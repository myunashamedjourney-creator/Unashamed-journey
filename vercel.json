{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "subscribe.js",
      "use": "@vercel/node"
    },
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/subscribe",
      "dest": "/subscribe.js"
    },
    {
      "src": "/instagram",
      "dest": "/index.html"
    },
    {
      "src": "/tiktok",
      "dest": "/index.html"
    },
    {
      "src": "/youtube",
      "dest": "/index.html"
    },
    {
      "src": "/instagram-reset",
      "dest": "/reset.html"
    },
    {
      "src": "/tiktok-reset",
      "dest": "/reset.html"
    },
    {
      "src": "/youtube-reset",
      "dest": "/reset.html"
    },
    {
      "src": "/(faith|mind|body|identity|relationships|method|rebuild|why|reset)",
      "dest": "/$1.html"
    },
    {
      "src": "/the-method",
      "dest": "/method.html"
    },
    {
      "src": "/why-uj",
      "dest": "/why.html"
    },
    {
      "src": "/7-day-reset",
      "dest": "/reset.html"
    },
    {
      "src": "/start-here",
      "status": 307,
      "headers": {
        "Location": "/#where-the-work-is"
      }
    },
    {
      "handle": "filesystem"
    }
  ]
}
