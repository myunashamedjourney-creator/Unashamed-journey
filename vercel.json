{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "subscribe.js",
      "use": "@vercel/node"
    },
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/subscribe",
      "dest": "/subscribe.js"
    },
    {
      "src": "/instagram",
      "dest": "/index.html"
    },
    {
      "src": "/tiktok",
      "dest": "/index.html"
    },
    {
      "src": "/youtube",
      "dest": "/index.html"
    },
    {
      "src": "/instagram-reset",
      "dest": "/reset.html"
    },
    {
      "src": "/tiktok-reset",
      "dest": "/reset.html"
    },
    {
      "src": "/youtube-reset",
      "dest": "/reset.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}